# syntax=docker/dockerfile:1.10@sha256:865e5dd094beca432e8c0a1d5e1c465db5f998dca4e439981029b3b81fb39ed5
ARG PYTHON_IMAGE=python:3.13.14-slim@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.1@sha256:cf4eedcaa81655197f625739489effcbe71b61ceb1506f332c3facae5deceded

FROM golang:1.26-alpine AS api-build
ARG SERVICE=agent-memory-api
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/service "./cmd/${SERVICE}"

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS adapter-build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /opt/adapter
COPY tools/graphrag-adapter/pyproject.toml tools/graphrag-adapter/uv.lock tools/graphrag-adapter/README.md ./
COPY tools/graphrag-adapter/src ./src
RUN uv sync --frozen --no-dev --no-editable --compile-bytecode

FROM ${PYTHON_IMAGE} AS runtime
ENV PATH=/opt/adapter/.venv/bin:$PATH \
    AGENT_MEMORY_GRAPHRAG_LOCK_FILE=/opt/adapter/uv.lock \
    LITELLM_LOCAL_MODEL_COST_MAP=true \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates wget \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 100 --user-group --no-create-home --shell /usr/sbin/nologin agentmemory
COPY --from=api-build /out/service /usr/local/bin/service
COPY --from=adapter-build --chown=100:100 /opt/adapter/.venv /opt/adapter/.venv
COPY --from=adapter-build --chown=100:100 /opt/adapter/uv.lock /opt/adapter/uv.lock
USER 100:100
ENTRYPOINT ["/usr/local/bin/service"]

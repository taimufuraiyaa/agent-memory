{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::agent-memory-vault"],
      "Condition": {"StringLike": {"s3:prefix": ["vault/*"]}}
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:PutObjectRetention"],
      "Resource": ["arn:aws:s3:::agent-memory-audit/audit/*"]
    }
  ]
}

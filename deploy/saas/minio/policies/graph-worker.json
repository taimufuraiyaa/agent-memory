{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::agent-memory-graph-projections/graph-projections/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::agent-memory-graph-artifacts/graph-artifacts/staging/*",
        "arn:aws:s3:::agent-memory-graph-artifacts/graph-artifacts/state/*"
      ]
    }
  ]
}

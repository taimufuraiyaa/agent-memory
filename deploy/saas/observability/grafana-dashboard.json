      "targets": [{"expr": "1 - (sum(rate(agent_memory_saas_http_requests_total{outcome=\"error\"}[5m])) / clamp_min(sum(rate(agent_memory_saas_http_requests_total[5m])), 0.001))"}],
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}

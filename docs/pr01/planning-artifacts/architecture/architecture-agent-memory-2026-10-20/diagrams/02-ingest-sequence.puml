@startuml 02-ingest-sequence
title PR01 — Write path: ingest -> normalization layer -> DB
autonumber

participant Client
participant "api" as API
participant "Ingestion\n(no storage access)" as ING
participant "Redactor" as RED
participant "Chunker" as CH
participant "Normalization layer\n(write gateway)" as N
participant "Rule-based\nnormalizer" as R
database "SQLite tx" as DB

Client -> API : write {workspace, type, content, keywords}
API -> ING : validate
ING -> RED : redact secrets
ING -> CH : estimate tokens
alt > 200k tokens
  CH --> Client : input_too_large (use study/library import)
else 2k - 200k tokens
  CH --> ING : passages (structure-aware, dedup)
  ING --> Client : job_id (async)
else <= 2k tokens
  CH --> ING : single passage
end
ING -> N : submit write batch (raw + passages + LLM budget)
loop each passage
  alt within budget and LLM ok
    N -> N : LLM normalize + validate (normalization=llm)
  else error / timeout / over budget
    N -> R : normalize
    R --> N : fields (normalization=fallback)
  end
end
N -> DB : one tx: memories(raw) + memory_index_docs\n+ passages + memory_fts + normalization_queue
DB --> N : commit
N --> ING : id, normalization, index_generation
ING --> Client : id (or job_id for async)
@enduml

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/public-beta-approval-export-manifest.schema.json",
  "title": "Agent Memory immutable public-beta approval export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "export_id", "gate", "exported_at", "files"],
  "properties": {
    "schema": {"const": "agent-memory-public-beta-approval-export-manifest-v1"},
    "export_id": {"$ref": "#/$defs/opaque"},
    "gate": {"const": "public_beta"},
    "exported_at": {"$ref": "#/$defs/timestamp"},
    "files": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "file": {"type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.json$"}, "sha256": {"$ref": "#/$defs/digest"}}}
  }
}

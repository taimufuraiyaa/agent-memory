{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/staging-migration-acceptance-input.schema.json",
  "title": "Agent Memory staging migration parity and rollback acceptance input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "acceptance_id", "rollback_plan_version", "cohort_id", "cohort_receipt_sha256", "parity_evaluation_id", "parity_receipt_sha256", "inventory_id", "inventory_receipt_sha256", "plan_id", "plan_receipt_sha256", "change_id", "change_receipt_sha256", "release_id", "release_receipt_sha256", "dataset_version", "rollback_plan_sha256", "tabletop_report_sha256", "acceptance_decision_sha256", "started_at", "completed_at", "generated_at", "ready", "checks"],
  "properties": {
    "schema": {"const": "agent-memory-staging-migration-acceptance-input-v1"},
    "classification": {"const": "staging_external"},
    "environment": {"const": "staging"},
    "acceptance_id": {"$ref": "#/$defs/opaque_id"}, "rollback_plan_version": {"$ref": "#/$defs/opaque_id"},
    "cohort_id": {"$ref": "#/$defs/opaque_id"}, "cohort_receipt_sha256": {"$ref": "#/$defs/digest"},
    "parity_evaluation_id": {"$ref": "#/$defs/opaque_id"}, "parity_receipt_sha256": {"$ref": "#/$defs/digest"},
    "inventory_id": {"$ref": "#/$defs/opaque_id"}, "inventory_receipt_sha256": {"$ref": "#/$defs/digest"},
    "plan_id": {"$ref": "#/$defs/opaque_id"}, "plan_receipt_sha256": {"$ref": "#/$defs/digest"},
    "change_id": {"$ref": "#/$defs/opaque_id"}, "change_receipt_sha256": {"$ref": "#/$defs/digest"},
    "release_id": {"$ref": "#/$defs/opaque_id"}, "release_receipt_sha256": {"$ref": "#/$defs/digest"},
    "dataset_version": {"$ref": "#/$defs/opaque_id"},
    "rollback_plan_sha256": {"$ref": "#/$defs/digest"}, "tabletop_report_sha256": {"$ref": "#/$defs/digest"}, "acceptance_decision_sha256": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "generated_at": {"type": "string", "format": "date-time"},
    "ready": {"type": "boolean"}, "checks": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "check": {"type": "object", "additionalProperties": false, "required": ["id", "outcome", "evidence_sha256"], "properties": {"id": {"enum": ["original_local_copy_preserved", "hosted_profile_disabled", "credential_revocation_rehearsed", "import_report_reconciled", "hosted_deletion_path_reviewed", "explicit_local_continuity_confirmed", "remigration_requires_fresh_bundle", "product_engineering_operations_review_complete"]}, "outcome": {"enum": ["passed", "failed", "inconclusive"]}, "evidence_sha256": {"$ref": "#/$defs/digest"}}}
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agent-memory.local/schemas/evidence/v1/checkpoint-zero-program-input.schema.json",
  "title":"Agent Memory checkpoint-zero program review input",
  "type":"object","additionalProperties":false,
  "required":["schema","classification","environment","review_id","decision_register_version","topology_version","recovery_plan_version","forecast_version","beta_cap_version","staffing_plan_version","inventory_id","inventory_receipt_sha256","launch_scope_decision_id","launch_scope_receipt_sha256","integration_review_id","integration_receipt_sha256","decision_register_sha256","topology_review_sha256","facility_review_sha256","recovery_exit_review_sha256","integration_boundary_sha256","jurisdiction_decision_sha256","blocker_register_sha256","cost_forecast_sha256","infrastructure_cost_cap_decision_sha256","beta_cap_decision_sha256","staffing_plan_sha256","cp0a_review_sha256","cp0b_review_sha256","reviewed_at","generated_at","forecast_monthly_cost_micro_usd","approved_infrastructure_monthly_cap_micro_usd","beta_account_cap","estimated_worst_case_beta_monthly_cost_micro_usd","approved_worst_case_beta_monthly_cap_micro_usd","ready","blockers","staffing","checks"],
  "properties":{
    "schema":{"const":"agent-memory-checkpoint-zero-program-input-v1"},"classification":{"const":"external_business"},"environment":{"enum":["staging","production"]},
    "review_id":{"$ref":"#/$defs/opaque"},"decision_register_version":{"$ref":"#/$defs/opaque"},"topology_version":{"$ref":"#/$defs/opaque"},"recovery_plan_version":{"$ref":"#/$defs/opaque"},"forecast_version":{"$ref":"#/$defs/opaque"},"beta_cap_version":{"$ref":"#/$defs/opaque"},"staffing_plan_version":{"$ref":"#/$defs/opaque"},
    "inventory_id":{"$ref":"#/$defs/opaque"},"inventory_receipt_sha256":{"$ref":"#/$defs/digest"},"launch_scope_decision_id":{"$ref":"#/$defs/opaque"},"launch_scope_receipt_sha256":{"$ref":"#/$defs/digest"},"integration_review_id":{"$ref":"#/$defs/opaque"},"integration_receipt_sha256":{"$ref":"#/$defs/digest"},
    "decision_register_sha256":{"$ref":"#/$defs/digest"},"topology_review_sha256":{"$ref":"#/$defs/digest"},"facility_review_sha256":{"$ref":"#/$defs/digest"},"recovery_exit_review_sha256":{"$ref":"#/$defs/digest"},"integration_boundary_sha256":{"$ref":"#/$defs/digest"},"jurisdiction_decision_sha256":{"$ref":"#/$defs/digest"},"blocker_register_sha256":{"$ref":"#/$defs/digest"},"cost_forecast_sha256":{"$ref":"#/$defs/digest"},"infrastructure_cost_cap_decision_sha256":{"$ref":"#/$defs/digest"},"beta_cap_decision_sha256":{"$ref":"#/$defs/digest"},"staffing_plan_sha256":{"$ref":"#/$defs/digest"},"cp0a_review_sha256":{"$ref":"#/$defs/digest"},"cp0b_review_sha256":{"$ref":"#/$defs/digest"},
    "reviewed_at":{"type":"string","format":"date-time"},"generated_at":{"type":"string","format":"date-time"},
    "forecast_monthly_cost_micro_usd":{"$ref":"#/$defs/money"},"approved_infrastructure_monthly_cap_micro_usd":{"$ref":"#/$defs/money"},"beta_account_cap":{"type":"integer","minimum":1,"maximum":1000000000},"estimated_worst_case_beta_monthly_cost_micro_usd":{"$ref":"#/$defs/money"},"approved_worst_case_beta_monthly_cap_micro_usd":{"$ref":"#/$defs/money"},
    "ready":{"type":"boolean"},"blockers":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/blocker"}},"staffing":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/staffing"}},"checks":{"type":"array","minItems":10,"maxItems":10,"items":{"$ref":"#/$defs/check"}}
  },
  "$defs":{
    "opaque":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"count":{"type":"integer","minimum":0,"maximum":1000000000},"money":{"type":"integer","minimum":0,"maximum":9223372036854775807},"outcome":{"enum":["passed","failed","inconclusive"]},
    "blocker":{"type":"object","additionalProperties":false,"required":["id","total_count","resolved_count","deferred_count","open_count","unowned_count","outcome","evidence_sha256"],"properties":{"id":{"enum":["infrastructure_ownership","topology","external_integration","jurisdiction"]},"total_count":{"$ref":"#/$defs/count"},"resolved_count":{"$ref":"#/$defs/count"},"deferred_count":{"$ref":"#/$defs/count"},"open_count":{"$ref":"#/$defs/count"},"unowned_count":{"$ref":"#/$defs/count"},"outcome":{"$ref":"#/$defs/outcome"},"evidence_sha256":{"$ref":"#/$defs/digest"}}},
    "staffing":{"type":"object","additionalProperties":false,"required":["id","required_coverage_minutes","primary_covered_minutes","backup_covered_minutes","primary_slot_count","backup_slot_count","outcome","evidence_sha256"],"properties":{"id":{"enum":["on_call","support","notice"]},"required_coverage_minutes":{"$ref":"#/$defs/count"},"primary_covered_minutes":{"$ref":"#/$defs/count"},"backup_covered_minutes":{"$ref":"#/$defs/count"},"primary_slot_count":{"$ref":"#/$defs/count"},"backup_slot_count":{"$ref":"#/$defs/count"},"outcome":{"$ref":"#/$defs/outcome"},"evidence_sha256":{"$ref":"#/$defs/digest"}}},
    "check":{"type":"object","additionalProperties":false,"required":["id","outcome","evidence_sha256"],"properties":{"id":{"enum":["launch_scope_ready","topology_inventory_valid","integration_review_ready","decision_register_reviewed","blockers_reconciled","component_recovery_exit_reviewed","infrastructure_forecast_within_cap","beta_economics_within_cap","staffing_coverage_complete","accountable_cp0_reviews_complete"]},"outcome":{"$ref":"#/$defs/outcome"},"evidence_sha256":{"$ref":"#/$defs/digest"}}}
  }
}

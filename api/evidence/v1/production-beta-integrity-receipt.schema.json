{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/production-beta-integrity-receipt.schema.json",
  "title": "Agent Memory production beta isolation and audit-integrity receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "review_id", "anomaly_engine_version", "audit_chain_verifier_version", "archive_reconciler_version", "signal_classification_version", "residual_risk_policy_version", "inventory_id", "inventory_receipt_sha256", "plan_id", "plan_receipt_sha256", "change_id", "change_receipt_sha256", "release_id", "release_receipt_sha256", "beta_slo_observation_id", "beta_slo_receipt_sha256", "beta_operations_assessment_id", "beta_operations_receipt_sha256", "window_start", "window_end", "audit_database_chain_report_sha256", "audit_archive_reconciliation_sha256", "isolation_signal_export_sha256", "audit_integrity_signal_export_sha256", "anomaly_report_sha256", "residual_risk_decision_sha256", "security_review_sha256", "risk_policy_approved_at", "snapshot_at", "reviewed_at", "generated_at", "audit_event_count", "chain_verified_event_count", "chain_break_count", "archive_expected_count", "archive_verified_count", "archive_missing_count", "archive_checksum_mismatch_count", "isolation_signal_count", "isolation_explained_signal_count", "isolation_unexplained_signal_count", "isolation_unclassified_signal_count", "audit_integrity_signal_count", "audit_integrity_explained_signal_count", "audit_integrity_unexplained_signal_count", "audit_integrity_unclassified_signal_count", "anomaly_finding_count", "closed_anomaly_finding_count", "open_anomaly_finding_count", "ready", "checks", "input_sha256", "collected_at", "chain_coverage_complete", "archive_reconciliation_complete", "isolation_classification_complete", "audit_integrity_classification_complete", "finding_closure_complete", "integrity_breach_count", "unexplained_signal_count", "unclassified_signal_count", "open_finding_count", "check_count", "passed_count", "failed_count", "inconclusive_count"],
  "properties": {
    "schema": {"const": "agent-memory-production-beta-integrity-receipt-v1"},
    "classification": {"const": "production_external"},
    "environment": {"const": "production"},
    "review_id": {"$ref": "#/$defs/opaque"},
    "anomaly_engine_version": {"$ref": "#/$defs/opaque"},
    "audit_chain_verifier_version": {"$ref": "#/$defs/opaque"},
    "archive_reconciler_version": {"$ref": "#/$defs/opaque"},
    "signal_classification_version": {"$ref": "#/$defs/opaque"},
    "residual_risk_policy_version": {"$ref": "#/$defs/opaque"},
    "inventory_id": {"$ref": "#/$defs/opaque"},
    "inventory_receipt_sha256": {"$ref": "#/$defs/digest"},
    "plan_id": {"$ref": "#/$defs/opaque"},
    "plan_receipt_sha256": {"$ref": "#/$defs/digest"},
    "change_id": {"$ref": "#/$defs/opaque"},
    "change_receipt_sha256": {"$ref": "#/$defs/digest"},
    "release_id": {"$ref": "#/$defs/opaque"},
    "release_receipt_sha256": {"$ref": "#/$defs/digest"},
    "beta_slo_observation_id": {"$ref": "#/$defs/opaque"},
    "beta_slo_receipt_sha256": {"$ref": "#/$defs/digest"},
    "beta_operations_assessment_id": {"$ref": "#/$defs/opaque"},
    "beta_operations_receipt_sha256": {"$ref": "#/$defs/digest"},
    "window_start": {"$ref": "#/$defs/timestamp"},
    "window_end": {"$ref": "#/$defs/timestamp"},
    "audit_database_chain_report_sha256": {"$ref": "#/$defs/digest"},
    "audit_archive_reconciliation_sha256": {"$ref": "#/$defs/digest"},
    "isolation_signal_export_sha256": {"$ref": "#/$defs/digest"},
    "audit_integrity_signal_export_sha256": {"$ref": "#/$defs/digest"},
    "anomaly_report_sha256": {"$ref": "#/$defs/digest"},
    "residual_risk_decision_sha256": {"$ref": "#/$defs/digest"},
    "security_review_sha256": {"$ref": "#/$defs/digest"},
    "risk_policy_approved_at": {"$ref": "#/$defs/timestamp"},
    "snapshot_at": {"$ref": "#/$defs/timestamp"},
    "reviewed_at": {"$ref": "#/$defs/timestamp"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "audit_event_count": {"$ref": "#/$defs/count"},
    "chain_verified_event_count": {"$ref": "#/$defs/count"},
    "chain_break_count": {"$ref": "#/$defs/count"},
    "archive_expected_count": {"$ref": "#/$defs/count"},
    "archive_verified_count": {"$ref": "#/$defs/count"},
    "archive_missing_count": {"$ref": "#/$defs/count"},
    "archive_checksum_mismatch_count": {"$ref": "#/$defs/count"},
    "isolation_signal_count": {"$ref": "#/$defs/count"},
    "isolation_explained_signal_count": {"$ref": "#/$defs/count"},
    "isolation_unexplained_signal_count": {"$ref": "#/$defs/count"},
    "isolation_unclassified_signal_count": {"$ref": "#/$defs/count"},
    "audit_integrity_signal_count": {"$ref": "#/$defs/count"},
    "audit_integrity_explained_signal_count": {"$ref": "#/$defs/count"},
    "audit_integrity_unexplained_signal_count": {"$ref": "#/$defs/count"},
    "audit_integrity_unclassified_signal_count": {"$ref": "#/$defs/count"},
    "anomaly_finding_count": {"$ref": "#/$defs/count"},
    "closed_anomaly_finding_count": {"$ref": "#/$defs/count"},
    "open_anomaly_finding_count": {"$ref": "#/$defs/count"},
    "ready": {"type": "boolean"},
    "checks": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/check"}},
    "input_sha256": {"$ref": "#/$defs/digest"},
    "collected_at": {"$ref": "#/$defs/timestamp"},
    "chain_coverage_complete": {"type": "boolean"},
    "archive_reconciliation_complete": {"type": "boolean"},
    "isolation_classification_complete": {"type": "boolean"},
    "audit_integrity_classification_complete": {"type": "boolean"},
    "finding_closure_complete": {"type": "boolean"},
    "integrity_breach_count": {"$ref": "#/$defs/count"},
    "unexplained_signal_count": {"$ref": "#/$defs/count"},
    "unclassified_signal_count": {"$ref": "#/$defs/count"},
    "open_finding_count": {"$ref": "#/$defs/count"},
    "check_count": {"const": 9},
    "passed_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "failed_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "inconclusive_count": {"type": "integer", "minimum": 0, "maximum": 9}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "count": {"type": "integer", "minimum": 0, "maximum": 100000000},
    "check_id": {"enum": ["shared_window_exports_complete", "audit_chain_verification_complete", "audit_archive_reconciliation_complete", "isolation_signals_classified", "audit_integrity_signals_classified", "anomaly_report_closed", "no_unexplained_isolation_signal", "no_unexplained_audit_integrity_signal", "security_residual_risk_review_complete"]},
    "check": {"type": "object", "additionalProperties": false, "required": ["id", "outcome", "evidence_sha256"], "properties": {"id": {"$ref": "#/$defs/check_id"}, "outcome": {"enum": ["passed", "failed", "inconclusive"]}, "evidence_sha256": {"$ref": "#/$defs/digest"}}}
  }
}

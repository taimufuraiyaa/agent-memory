{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/launch-scope-receipt.schema.json",
  "title": "Agent Memory launch-scope and legal-position receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "scope_decision_id", "scope_decision_version", "jurisdiction_policy_version", "legal_review_version", "risk_register_version", "decision_register_sha256", "launch_scope_decision_sha256", "jurisdiction_memo_sha256", "policy_manifest_sha256", "legal_review_sha256", "risk_register_sha256", "input_sha256", "scope_approved_at", "legal_review_completed_at", "generated_at", "collected_at", "launch_country_count", "minimum_age_years", "support_language_count", "notice_jurisdiction_count", "blocking_risk_count", "unowned_risk_count", "deferred_risk_count", "ready", "legal_position_count", "legal_passed_count", "legal_failed_count", "legal_inconclusive_count", "check_count", "passed_count", "failed_count", "inconclusive_count", "legal_positions", "checks"],
  "properties": {
    "schema": {"const": "agent-memory-launch-scope-receipt-v1"},
    "classification": {"const": "external_business"}, "environment": {"const": "external"},
    "scope_decision_id": {"$ref": "#/$defs/opaque_id"}, "scope_decision_version": {"$ref": "#/$defs/opaque_id"}, "jurisdiction_policy_version": {"$ref": "#/$defs/opaque_id"}, "legal_review_version": {"$ref": "#/$defs/opaque_id"}, "risk_register_version": {"$ref": "#/$defs/opaque_id"},
    "decision_register_sha256": {"$ref": "#/$defs/digest"}, "launch_scope_decision_sha256": {"$ref": "#/$defs/digest"}, "jurisdiction_memo_sha256": {"$ref": "#/$defs/digest"}, "policy_manifest_sha256": {"$ref": "#/$defs/digest"}, "legal_review_sha256": {"$ref": "#/$defs/digest"}, "risk_register_sha256": {"$ref": "#/$defs/digest"}, "input_sha256": {"$ref": "#/$defs/digest"},
    "scope_approved_at": {"type": "string", "format": "date-time"}, "legal_review_completed_at": {"type": "string", "format": "date-time"}, "generated_at": {"type": "string", "format": "date-time"}, "collected_at": {"type": "string", "format": "date-time"},
    "launch_country_count": {"$ref": "#/$defs/positive_count"}, "minimum_age_years": {"type": "integer", "minimum": 1, "maximum": 120}, "support_language_count": {"$ref": "#/$defs/positive_count"}, "notice_jurisdiction_count": {"$ref": "#/$defs/positive_count"},
    "blocking_risk_count": {"$ref": "#/$defs/count"}, "unowned_risk_count": {"$ref": "#/$defs/count"}, "deferred_risk_count": {"$ref": "#/$defs/count"},
    "ready": {"type": "boolean"}, "legal_position_count": {"const": 6}, "legal_passed_count": {"type": "integer", "minimum": 0, "maximum": 6}, "legal_failed_count": {"type": "integer", "minimum": 0, "maximum": 6}, "legal_inconclusive_count": {"type": "integer", "minimum": 0, "maximum": 6},
    "check_count": {"const": 8}, "passed_count": {"type": "integer", "minimum": 0, "maximum": 8}, "failed_count": {"type": "integer", "minimum": 0, "maximum": 8}, "inconclusive_count": {"type": "integer", "minimum": 0, "maximum": 8},
    "legal_positions": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/legal_position"}}, "checks": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "opaque_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 1000000}, "positive_count": {"type": "integer", "minimum": 1, "maximum": 1000000}, "outcome": {"enum": ["passed", "failed", "inconclusive"]},
    "legal_position": {"type": "object", "additionalProperties": false, "required": ["id", "policy_copy_sha256", "review_evidence_sha256", "outcome"], "properties": {"id": {"enum": ["rights_attestation", "source_retention", "rights_notice", "deletion", "backup", "audit_retention"]}, "policy_copy_sha256": {"$ref": "#/$defs/digest"}, "review_evidence_sha256": {"$ref": "#/$defs/digest"}, "outcome": {"$ref": "#/$defs/outcome"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["id", "outcome", "evidence_sha256"], "properties": {"id": {"enum": ["launch_scope_approved", "jurisdiction_memo_complete", "minimum_age_recorded", "support_language_coverage_recorded", "notice_jurisdiction_routing_recorded", "legal_positions_reviewed", "risk_register_reconciled", "product_counsel_privacy_review_complete"]}, "outcome": {"$ref": "#/$defs/outcome"}, "evidence_sha256": {"$ref": "#/$defs/digest"}}}
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agent-memory.local/schemas/evidence/v1/production-ga-scorecard-receipt.schema.json",
  "title":"Agent Memory production GA scorecard receipt",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","classification","environment","scorecard_id","metric_source_version","query_manifest_version","target_version","window_decision_version","inventory_id","inventory_receipt_sha256","plan_id","plan_receipt_sha256","change_id","change_receipt_sha256","release_id","release_receipt_sha256","scorecard_export_sha256","query_manifest_sha256","window_decision_sha256","target_decision_sha256","product_domain_review_sha256","window_approved_at","window_start","window_end","evaluated_at","generated_at","approved_cost_per_active_tenant_microusd","ready","metrics","checks","input_sha256","collected_at","observation_duration_seconds","coverage_complete","coverage_shortfall_count","metric_breach_count","retention_passed","metric_results","check_count","passed_count","failed_count","inconclusive_count"],
  "properties":{
    "schema":{"const":"agent-memory-production-ga-scorecard-receipt-v1"},"classification":{"const":"production_external"},"environment":{"const":"production"},
    "scorecard_id":{"$ref":"#/$defs/opaque"},"metric_source_version":{"$ref":"#/$defs/opaque"},"query_manifest_version":{"$ref":"#/$defs/opaque"},"target_version":{"$ref":"#/$defs/opaque"},"window_decision_version":{"$ref":"#/$defs/opaque"},
    "inventory_id":{"$ref":"#/$defs/opaque"},"inventory_receipt_sha256":{"$ref":"#/$defs/digest"},"plan_id":{"$ref":"#/$defs/opaque"},"plan_receipt_sha256":{"$ref":"#/$defs/digest"},"change_id":{"$ref":"#/$defs/opaque"},"change_receipt_sha256":{"$ref":"#/$defs/digest"},"release_id":{"$ref":"#/$defs/opaque"},"release_receipt_sha256":{"$ref":"#/$defs/digest"},
    "scorecard_export_sha256":{"$ref":"#/$defs/digest"},"query_manifest_sha256":{"$ref":"#/$defs/digest"},"window_decision_sha256":{"$ref":"#/$defs/digest"},"target_decision_sha256":{"$ref":"#/$defs/digest"},"product_domain_review_sha256":{"$ref":"#/$defs/digest"},
    "window_approved_at":{"type":"string","format":"date-time"},"window_start":{"type":"string","format":"date-time"},"window_end":{"type":"string","format":"date-time"},"evaluated_at":{"type":"string","format":"date-time"},"generated_at":{"type":"string","format":"date-time"},
    "approved_cost_per_active_tenant_microusd":{"type":"integer","minimum":1,"maximum":1000000000000000},"ready":{"type":"boolean"},"metrics":{"type":"array","minItems":13,"maxItems":13,"items":{"$ref":"#/$defs/metric"}},"checks":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/check"}},
    "input_sha256":{"$ref":"#/$defs/digest"},"collected_at":{"type":"string","format":"date-time"},"observation_duration_seconds":{"type":"integer","minimum":2419200,"maximum":8035200},"coverage_complete":{"type":"boolean"},"coverage_shortfall_count":{"type":"integer","minimum":0,"maximum":13},"metric_breach_count":{"type":"integer","minimum":0,"maximum":13},"retention_passed":{"type":"boolean"},"metric_results":{"type":"array","minItems":13,"maxItems":13,"items":{"$ref":"#/$defs/metric_result"}},"check_count":{"const":7},"passed_count":{"type":"integer","minimum":0,"maximum":7},"failed_count":{"type":"integer","minimum":0,"maximum":7},"inconclusive_count":{"type":"integer","minimum":0,"maximum":7}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"opaque":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "metric_id":{"enum":["api_availability_ppm","search_p95_microseconds","memory_write_p95_microseconds","critical_high_exploitable_findings","tenant_isolation_passed","deletion_within_target_ppm","audit_integrity_verified_ppm","billing_reconciled_ppm","restore_rpo_minutes","restore_rto_minutes","cost_per_active_tenant_microusd","support_response_within_target_ppm","retention_deletions_within_target_ppm"]},
    "check_id":{"enum":["ga_window_approved","immutable_scorecard_export_complete","query_manifest_reviewed","metric_sample_coverage_complete","ga_targets_met","retention_coverage_and_target_met","product_domain_owner_review_complete"]},
    "metric":{"type":"object","additionalProperties":false,"required":["id","observed_value","expected_sample_count","observed_sample_count","evidence_sha256"],"properties":{"id":{"$ref":"#/$defs/metric_id"},"observed_value":{"type":"integer","minimum":0,"maximum":1000000000000000},"expected_sample_count":{"type":"integer","minimum":1,"maximum":1000000000},"observed_sample_count":{"type":"integer","minimum":1,"maximum":1000000000},"evidence_sha256":{"$ref":"#/$defs/digest"}}},
    "metric_result":{"type":"object","additionalProperties":false,"required":["id","observed_value","expected_sample_count","observed_sample_count","evidence_sha256","comparator","target_value","coverage_complete","passed"],"properties":{"id":{"$ref":"#/$defs/metric_id"},"observed_value":{"type":"integer","minimum":0,"maximum":1000000000000000},"expected_sample_count":{"type":"integer","minimum":1,"maximum":1000000000},"observed_sample_count":{"type":"integer","minimum":1,"maximum":1000000000},"evidence_sha256":{"$ref":"#/$defs/digest"},"comparator":{"enum":["gte","lte"]},"target_value":{"type":"integer","minimum":0,"maximum":1000000000000000},"coverage_complete":{"type":"boolean"},"passed":{"type":"boolean"}}},
    "check":{"type":"object","additionalProperties":false,"required":["id","outcome","evidence_sha256"],"properties":{"id":{"$ref":"#/$defs/check_id"},"outcome":{"enum":["passed","failed","inconclusive"]},"evidence_sha256":{"$ref":"#/$defs/digest"}}}
  }
}

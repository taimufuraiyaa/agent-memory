{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/staging-internal-alpha-receipt.schema.json",
  "title": "Agent Memory release-bound internal-alpha evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "classification", "environment", "cohort_id", "review_version",
    "inventory_id", "inventory_receipt_sha256", "plan_id", "plan_receipt_sha256",
    "change_id", "change_receipt_sha256", "release_id", "release_receipt_sha256",
    "journey_receipt_sha256", "cohort_decision_sha256", "source_policy_sha256",
    "support_policy_sha256", "deletion_manifest_sha256", "trace_audit_manifest_sha256",
    "product_qa_operations_review_sha256", "started_at", "completed_at", "generated_at",
    "ready", "account_count", "approved_source_count_cap", "approved_source_bytes_cap",
    "source_count", "source_bytes", "formats", "stages", "support", "deletion", "checks",
    "input_sha256", "collected_at", "alpha_days", "format_count", "stage_count",
    "support_case_count", "target_breach_count", "check_count", "passed_count", "failed_count"
  ],
  "properties": {
    "schema": {"const": "agent-memory-staging-internal-alpha-receipt-v1"},
    "classification": {"const": "staging_external"},
    "environment": {"const": "staging"},
    "cohort_id": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/opaque"},
    "review_version": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/opaque"},
    "inventory_id": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/opaque"},
    "inventory_receipt_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "plan_id": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/opaque"},
    "plan_receipt_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "change_id": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/opaque"},
    "change_receipt_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "release_id": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/opaque"},
    "release_receipt_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "journey_receipt_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "cohort_decision_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "source_policy_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "support_policy_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "deletion_manifest_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "trace_audit_manifest_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "product_qa_operations_review_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "ready": {"type": "boolean"},
    "account_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "approved_source_count_cap": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "approved_source_bytes_cap": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
    "source_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "source_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
    "formats": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/formats"},
    "stages": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/stages"},
    "support": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/support"},
    "deletion": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/deletion"},
    "checks": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/checks"},
    "input_sha256": {"$ref": "staging-internal-alpha-input.schema.json#/$defs/digest"},
    "collected_at": {"type": "string", "format": "date-time"},
    "alpha_days": {"type": "integer", "minimum": 28, "maximum": 93},
    "format_count": {"const": 4},
    "stage_count": {"const": 11},
    "support_case_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "target_breach_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "check_count": {"const": 9},
    "passed_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "failed_count": {"type": "integer", "minimum": 0, "maximum": 9}
  }
}

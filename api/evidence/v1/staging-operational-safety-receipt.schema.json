{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/staging-operational-safety-receipt.schema.json",
  "title": "Agent Memory staging operational-safety receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "bundle_id", "inventory_id", "inventory_receipt_sha256", "plan_id", "plan_receipt_sha256", "change_id", "change_receipt_sha256", "baseline_release_id", "baseline_receipt_sha256", "failed_attempt_release_id", "failed_attempt_receipt_sha256", "rollback_receipt_sha256", "input_sha256", "ready", "generated_at", "collected_at", "drill_count", "check_count", "passed_count", "failed_count", "inconclusive_count", "drills"],
  "properties": {
    "schema": {"const": "agent-memory-staging-operational-safety-receipt-v1"},
    "classification": {"const": "staging_external"},
    "environment": {"const": "staging"},
    "bundle_id": {"$ref": "#/$defs/opaque_id"},
    "inventory_id": {"$ref": "#/$defs/opaque_id"},
    "inventory_receipt_sha256": {"$ref": "#/$defs/digest"},
    "plan_id": {"$ref": "#/$defs/opaque_id"},
    "plan_receipt_sha256": {"$ref": "#/$defs/digest"},
    "change_id": {"$ref": "#/$defs/opaque_id"},
    "change_receipt_sha256": {"$ref": "#/$defs/digest"},
    "baseline_release_id": {"$ref": "#/$defs/opaque_id"},
    "baseline_receipt_sha256": {"$ref": "#/$defs/digest"},
    "failed_attempt_release_id": {"$ref": "#/$defs/opaque_id"},
    "failed_attempt_receipt_sha256": {"$ref": "#/$defs/digest"},
    "rollback_receipt_sha256": {"$ref": "#/$defs/digest"},
    "input_sha256": {"$ref": "#/$defs/digest"},
    "ready": {"type": "boolean"},
    "generated_at": {"type": "string", "format": "date-time"},
    "collected_at": {"type": "string", "format": "date-time"},
    "drill_count": {"const": 2},
    "check_count": {"const": 14},
    "passed_count": {"type": "integer", "minimum": 0, "maximum": 14},
    "failed_count": {"type": "integer", "minimum": 0, "maximum": 14},
    "inconclusive_count": {"type": "integer", "minimum": 0, "maximum": 14},
    "drills": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/drill"},
      "prefixItems": [
        {"properties": {"id": {"const": "managed_secret_rotation"}}},
        {"properties": {"id": {"const": "human_operator_access"}}}
      ]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "evidence_sha256"],
      "properties": {
        "id": {"enum": ["managed_replacement_created", "workload_rollout_completed", "old_value_rejected", "new_value_accepted", "service_recovered", "human_identity_verified", "independent_approval_verified", "least_privilege_scope_verified", "access_expiry_enforced", "access_revoked", "immutable_audit_retained", "customer_content_absent"]},
        "outcome": {"enum": ["passed", "failed", "inconclusive"]},
        "evidence_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "drill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "started_at", "completed_at", "checks"],
      "properties": {
        "id": {"enum": ["managed_secret_rotation", "human_operator_access"]},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "checks": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/check"}}
      }
    }
  }
}

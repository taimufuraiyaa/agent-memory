{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agent-memory.local/schemas/evidence/v1/private-beta-blocker-review-input.schema.json","title":"Agent Memory private-beta blocker review input","type":"object","additionalProperties":false,

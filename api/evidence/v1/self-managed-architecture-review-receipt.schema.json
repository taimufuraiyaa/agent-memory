{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/self-managed-architecture-review-receipt.schema.json",
  "title": "Agent Memory self-managed architecture review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "review_id", "review_version", "inventory_id", "inventory_receipt_sha256", "topology_adr_manifest_sha256", "service_adr_manifest_sha256", "facility_inventory_sha256", "failure_domain_review_sha256", "data_flow_manifest_sha256", "integration_contract_manifest_sha256", "accountable_review_sha256", "reviewed_at", "generated_at", "ready", "facility_count", "reviewed_failure_domain_count", "independent_failure_domain_count", "components", "data_flows", "integrations", "checks", "input_sha256", "collected_at", "component_count", "component_domain_review_count", "passed_component_count", "failed_component_count", "inconclusive_component_count", "data_flow_count", "passed_data_flow_count", "failed_data_flow_count", "inconclusive_data_flow_count", "integration_count", "passed_integration_count", "failed_integration_count", "inconclusive_integration_count", "check_count", "passed_count", "failed_count", "inconclusive_count"],
  "properties": {
    "schema": {"const": "agent-memory-self-managed-architecture-review-receipt-v1"},
    "classification": {"const": "self_managed_external"},
    "environment": {"enum": ["staging", "production"]},
    "review_id": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/opaque"},
    "review_version": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/opaque"},
    "inventory_id": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/opaque"},
    "inventory_receipt_sha256": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/digest"},
    "topology_adr_manifest_sha256": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/digest"},
    "service_adr_manifest_sha256": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/digest"},
    "facility_inventory_sha256": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/digest"},
    "failure_domain_review_sha256": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/digest"},
    "data_flow_manifest_sha256": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/digest"},
    "integration_contract_manifest_sha256": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/digest"},
    "accountable_review_sha256": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/digest"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "ready": {"type": "boolean"},
    "facility_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "reviewed_failure_domain_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "independent_failure_domain_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "components": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/components"},
    "data_flows": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/data_flows"},
    "integrations": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/integrations"},
    "checks": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/checks"},
    "input_sha256": {"$ref": "self-managed-architecture-review-input.schema.json#/$defs/digest"},
    "collected_at": {"type": "string", "format": "date-time"},
    "component_count": {"const": 8},
    "component_domain_review_count": {"const": 48},
    "passed_component_count": {"type": "integer", "minimum": 0, "maximum": 8},
    "failed_component_count": {"type": "integer", "minimum": 0, "maximum": 8},
    "inconclusive_component_count": {"type": "integer", "minimum": 0, "maximum": 8},
    "data_flow_count": {"const": 8},
    "passed_data_flow_count": {"type": "integer", "minimum": 0, "maximum": 8},
    "failed_data_flow_count": {"type": "integer", "minimum": 0, "maximum": 8},
    "inconclusive_data_flow_count": {"type": "integer", "minimum": 0, "maximum": 8},
    "integration_count": {"const": 3},
    "passed_integration_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "failed_integration_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "inconclusive_integration_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "check_count": {"const": 10},
    "passed_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "failed_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "inconclusive_count": {"type": "integer", "minimum": 0, "maximum": 10}
  }
}

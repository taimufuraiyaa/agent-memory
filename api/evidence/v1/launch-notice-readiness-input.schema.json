{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agent-memory.local/schemas/evidence/v1/launch-notice-readiness-input.schema.json",
  "title":"Agent Memory launch notice readiness input",
  "type":"object","additionalProperties":false,
  "required":["schema","classification","environment","review_id","workflow_policy_version","copy_manifest_version","routing_policy_version","deadline_policy_version","escalation_policy_version","repeat_abuse_policy_version","tabletop_version","staffing_plan_version","scope_decision_id","launch_scope_receipt_sha256","workflow_policy_sha256","copy_manifest_sha256","routing_policy_sha256","deadline_policy_sha256","escalation_policy_sha256","repeat_abuse_policy_sha256","tabletop_report_sha256","staffing_plan_sha256","counsel_review_sha256","legal_operations_review_sha256","support_review_sha256","reviewed_at","generated_at","ready","routes","staffing","scenarios","checks"],
  "properties":{
    "schema":{"const":"agent-memory-launch-notice-readiness-input-v1"},"classification":{"const":"external_business"},"environment":{"const":"external"},
    "review_id":{"$ref":"#/$defs/opaque"},"workflow_policy_version":{"$ref":"#/$defs/opaque"},"copy_manifest_version":{"$ref":"#/$defs/opaque"},"routing_policy_version":{"$ref":"#/$defs/opaque"},"deadline_policy_version":{"$ref":"#/$defs/opaque"},"escalation_policy_version":{"$ref":"#/$defs/opaque"},"repeat_abuse_policy_version":{"$ref":"#/$defs/opaque"},"tabletop_version":{"$ref":"#/$defs/opaque"},"staffing_plan_version":{"$ref":"#/$defs/opaque"},"scope_decision_id":{"$ref":"#/$defs/opaque"},
    "launch_scope_receipt_sha256":{"$ref":"#/$defs/digest"},"workflow_policy_sha256":{"$ref":"#/$defs/digest"},"copy_manifest_sha256":{"$ref":"#/$defs/digest"},"routing_policy_sha256":{"$ref":"#/$defs/digest"},"deadline_policy_sha256":{"$ref":"#/$defs/digest"},"escalation_policy_sha256":{"$ref":"#/$defs/digest"},"repeat_abuse_policy_sha256":{"$ref":"#/$defs/digest"},"tabletop_report_sha256":{"$ref":"#/$defs/digest"},"staffing_plan_sha256":{"$ref":"#/$defs/digest"},"counsel_review_sha256":{"$ref":"#/$defs/digest"},"legal_operations_review_sha256":{"$ref":"#/$defs/digest"},"support_review_sha256":{"$ref":"#/$defs/digest"},
    "reviewed_at":{"type":"string","format":"date-time"},"generated_at":{"type":"string","format":"date-time"},"ready":{"type":"boolean"},
    "routes":{"type":"array","minItems":1,"maxItems":1000000,"items":{"$ref":"#/$defs/route"}},"staffing":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/staffing"}},"scenarios":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/scenario"}},"checks":{"type":"array","minItems":10,"maxItems":10,"items":{"$ref":"#/$defs/check"}}
  },
  "$defs":{
    "opaque":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"count":{"type":"integer","minimum":0,"maximum":1000000000},"outcome":{"enum":["passed","failed","inconclusive"]},
    "route":{"type":"object","additionalProperties":false,"required":["jurisdiction_ref_sha256","required_language_count","covered_language_count","normal_validation_deadline_seconds","urgent_validation_deadline_seconds","primary_escalation_path_count","backup_escalation_path_count","copy_sha256","routing_sha256","deadline_policy_sha256","escalation_sha256","outcome"],"properties":{"jurisdiction_ref_sha256":{"$ref":"#/$defs/digest"},"required_language_count":{"$ref":"#/$defs/count"},"covered_language_count":{"$ref":"#/$defs/count"},"normal_validation_deadline_seconds":{"$ref":"#/$defs/count"},"urgent_validation_deadline_seconds":{"$ref":"#/$defs/count"},"primary_escalation_path_count":{"$ref":"#/$defs/count"},"backup_escalation_path_count":{"$ref":"#/$defs/count"},"copy_sha256":{"$ref":"#/$defs/digest"},"routing_sha256":{"$ref":"#/$defs/digest"},"deadline_policy_sha256":{"$ref":"#/$defs/digest"},"escalation_sha256":{"$ref":"#/$defs/digest"},"outcome":{"enum":["passed","failed"]}}},
    "staffing":{"type":"object","additionalProperties":false,"required":["id","required_coverage_minutes","primary_covered_minutes","backup_covered_minutes","primary_slot_count","backup_slot_count","outcome","evidence_sha256"],"properties":{"id":{"enum":["notice_intake","legal_review","user_response"]},"required_coverage_minutes":{"$ref":"#/$defs/count"},"primary_covered_minutes":{"$ref":"#/$defs/count"},"backup_covered_minutes":{"$ref":"#/$defs/count"},"primary_slot_count":{"$ref":"#/$defs/count"},"backup_slot_count":{"$ref":"#/$defs/count"},"outcome":{"enum":["passed","failed"]},"evidence_sha256":{"$ref":"#/$defs/digest"}}},
    "scenario":{"type":"object","additionalProperties":false,"required":["id","executed_count","passed_count","failed_count","inconclusive_count","maximum_target_seconds","maximum_observed_seconds","outcome","evidence_sha256"],"properties":{"id":{"enum":["valid_notice","invalid_notice","conflicting_notice","urgent_notice"]},"executed_count":{"$ref":"#/$defs/count"},"passed_count":{"$ref":"#/$defs/count"},"failed_count":{"$ref":"#/$defs/count"},"inconclusive_count":{"$ref":"#/$defs/count"},"maximum_target_seconds":{"$ref":"#/$defs/count"},"maximum_observed_seconds":{"$ref":"#/$defs/count"},"outcome":{"$ref":"#/$defs/outcome"},"evidence_sha256":{"$ref":"#/$defs/digest"}}},
    "check":{"type":"object","additionalProperties":false,"required":["id","outcome","evidence_sha256"],"properties":{"id":{"enum":["launch_scope_ready","workflow_policy_complete","jurisdiction_routing_complete","copy_language_coverage_complete","deadline_policy_complete","escalation_paths_complete","staffing_coverage_complete","tabletop_scenarios_complete","repeat_abuse_review_complete","accountable_reviews_complete"]},"outcome":{"$ref":"#/$defs/outcome"},"evidence_sha256":{"$ref":"#/$defs/digest"}}}

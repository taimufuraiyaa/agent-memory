{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agent-memory.local/schemas/evidence/v1/external-integration-review-receipt.schema.json",
  "title":"Agent Memory external-integration data-purpose review receipt",
  "type":"object","additionalProperties":false,
  "required":["schema","classification","environment","review_id","policy_version","traffic_review_version","inventory_id","inventory_receipt_sha256","data_policy_sha256","integration_manifest_sha256","review_decision_sha256","input_sha256","reviewed_at","generated_at","collected_at","ready","integration_count","enabled_count","disabled_count","passed_integration_count","failed_integration_count","inconclusive_integration_count","approved_data_field_count","sampled_request_count","customer_content_byte_count","unapproved_field_count","unallowlisted_destination_count","check_count","passed_count","failed_count","inconclusive_count","integrations","checks"],
  "properties":{
    "schema":{"const":"agent-memory-external-integration-review-receipt-v1"},"classification":{"const":"self_managed_external"},"environment":{"enum":["staging","production"]},
    "review_id":{"$ref":"#/$defs/opaque"},"policy_version":{"$ref":"#/$defs/opaque"},"traffic_review_version":{"$ref":"#/$defs/opaque"},"inventory_id":{"$ref":"#/$defs/opaque"},
    "inventory_receipt_sha256":{"$ref":"#/$defs/digest"},"data_policy_sha256":{"$ref":"#/$defs/digest"},"integration_manifest_sha256":{"$ref":"#/$defs/digest"},"review_decision_sha256":{"$ref":"#/$defs/digest"},"input_sha256":{"$ref":"#/$defs/digest"},
    "reviewed_at":{"type":"string","format":"date-time"},"generated_at":{"type":"string","format":"date-time"},"collected_at":{"type":"string","format":"date-time"},"ready":{"type":"boolean"},
    "integration_count":{"const":3},"enabled_count":{"type":"integer","minimum":0,"maximum":3},"disabled_count":{"type":"integer","minimum":0,"maximum":3},"passed_integration_count":{"type":"integer","minimum":0,"maximum":3},"failed_integration_count":{"type":"integer","minimum":0,"maximum":3},"inconclusive_integration_count":{"type":"integer","minimum":0,"maximum":3},
    "approved_data_field_count":{"$ref":"#/$defs/count"},"sampled_request_count":{"$ref":"#/$defs/count"},"customer_content_byte_count":{"$ref":"#/$defs/count"},"unapproved_field_count":{"$ref":"#/$defs/count"},"unallowlisted_destination_count":{"$ref":"#/$defs/count"},
    "check_count":{"const":7},"passed_count":{"type":"integer","minimum":0,"maximum":7},"failed_count":{"type":"integer","minimum":0,"maximum":7},"inconclusive_count":{"type":"integer","minimum":0,"maximum":7},
    "integrations":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/integration"}},"checks":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/check"}}
  },
  "$defs":{
    "opaque":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"count":{"type":"integer","minimum":0,"maximum":1000000000},"outcome":{"enum":["passed","failed","inconclusive"]},
    "integration":{"type":"object","additionalProperties":false,"required":["kind","enabled","configuration_version","purpose_version","configuration_sha256","purpose_decision_sha256","contract_or_disabled_state_sha256","retention_training_settings_sha256","traffic_export_sha256","exit_plan_sha256","approved_data_field_count","sampled_request_count","customer_content_byte_count","unapproved_field_count","unallowlisted_destination_count","provider_training_enabled","general_logging_enabled","outcome"],"properties":{"kind":{"enum":["payment","email","model"]},"enabled":{"type":"boolean"},"configuration_version":{"$ref":"#/$defs/opaque"},"purpose_version":{"$ref":"#/$defs/opaque"},"configuration_sha256":{"$ref":"#/$defs/digest"},"purpose_decision_sha256":{"$ref":"#/$defs/digest"},"contract_or_disabled_state_sha256":{"$ref":"#/$defs/digest"},"retention_training_settings_sha256":{"$ref":"#/$defs/digest"},"traffic_export_sha256":{"$ref":"#/$defs/digest"},"exit_plan_sha256":{"$ref":"#/$defs/digest"},"approved_data_field_count":{"$ref":"#/$defs/count"},"sampled_request_count":{"$ref":"#/$defs/count"},"customer_content_byte_count":{"$ref":"#/$defs/count"},"unapproved_field_count":{"$ref":"#/$defs/count"},"unallowlisted_destination_count":{"$ref":"#/$defs/count"},"provider_training_enabled":{"type":"boolean"},"general_logging_enabled":{"type":"boolean"},"outcome":{"$ref":"#/$defs/outcome"}}},
    "check":{"type":"object","additionalProperties":false,"required":["id","outcome","evidence_sha256"],"properties":{"id":{"enum":["inventory_binding_verified","purpose_approved","contract_or_disabled_state_reviewed","retention_training_settings_reviewed","traffic_allowlist_verified","content_minimization_verified","privacy_security_review_complete"]},"outcome":{"$ref":"#/$defs/outcome"},"evidence_sha256":{"$ref":"#/$defs/digest"}}}
  }
}

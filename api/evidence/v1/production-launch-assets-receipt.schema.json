{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/production-launch-assets-receipt.schema.json",
  "title": "Agent Memory production public launch-assets receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "review_id", "manifest_version", "probe_version", "copy_review_version", "monitoring_review_version", "inventory_id", "inventory_receipt_sha256", "plan_id", "plan_receipt_sha256", "change_id", "change_receipt_sha256", "release_id", "release_receipt_sha256", "manifest_sha256", "accountable_review_sha256", "snapshot_at", "reviewed_at", "generated_at", "ready", "assets", "checks", "input_sha256", "collected_at", "asset_count", "live_asset_count", "stale_asset_count", "asset_results", "check_count", "passed_count", "failed_count", "inconclusive_count"],
  "properties": {
    "schema": {"const": "agent-memory-production-launch-assets-receipt-v1"},
    "classification": {"const": "production_external"},
    "environment": {"const": "production"},
    "review_id": {"$ref": "#/$defs/opaque"},
    "manifest_version": {"$ref": "#/$defs/opaque"},
    "probe_version": {"$ref": "#/$defs/opaque"},
    "copy_review_version": {"$ref": "#/$defs/opaque"},
    "monitoring_review_version": {"$ref": "#/$defs/opaque"},
    "inventory_id": {"$ref": "#/$defs/opaque"},
    "inventory_receipt_sha256": {"$ref": "#/$defs/digest"},
    "plan_id": {"$ref": "#/$defs/opaque"},
    "plan_receipt_sha256": {"$ref": "#/$defs/digest"},
    "change_id": {"$ref": "#/$defs/opaque"},
    "change_receipt_sha256": {"$ref": "#/$defs/digest"},
    "release_id": {"$ref": "#/$defs/opaque"},
    "release_receipt_sha256": {"$ref": "#/$defs/digest"},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "accountable_review_sha256": {"$ref": "#/$defs/digest"},
    "snapshot_at": {"$ref": "#/$defs/timestamp"},
    "reviewed_at": {"$ref": "#/$defs/timestamp"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "ready": {"type": "boolean"},
    "assets": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/asset"}},
    "checks": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/check"}},
    "input_sha256": {"$ref": "#/$defs/digest"},
    "collected_at": {"$ref": "#/$defs/timestamp"},
    "asset_count": {"const": 7},
    "live_asset_count": {"type": "integer", "minimum": 0, "maximum": 7},
    "stale_asset_count": {"type": "integer", "minimum": 0, "maximum": 7},
    "asset_results": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/asset_result"}},
    "check_count": {"const": 9},
    "passed_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "failed_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "inconclusive_count": {"type": "integer", "minimum": 0, "maximum": 9}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "asset_id": {"enum": ["external_signup", "terms_of_service", "privacy_notice", "content_rights_policy", "status_page", "support_policy", "security_contact"]},
    "owner_group": {"enum": ["product", "product_counsel", "operations", "support_operations", "security"]},
    "check_id": {"enum": ["launch_asset_manifest_complete", "immutable_copy_review_complete", "live_probe_coverage_complete", "asset_ownership_complete", "monitoring_routes_tested", "product_review_complete", "counsel_review_complete", "support_review_complete", "security_review_complete"]},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "owner_group", "public_url_sha256", "rendered_copy_sha256", "monitoring_config_sha256", "route_test_sha256", "owner_decision_sha256", "observed_at", "http_status", "probe_count", "successful_probe_count"],
      "properties": {"id": {"$ref": "#/$defs/asset_id"}, "owner_group": {"$ref": "#/$defs/owner_group"}, "public_url_sha256": {"$ref": "#/$defs/digest"}, "rendered_copy_sha256": {"$ref": "#/$defs/digest"}, "monitoring_config_sha256": {"$ref": "#/$defs/digest"}, "route_test_sha256": {"$ref": "#/$defs/digest"}, "owner_decision_sha256": {"$ref": "#/$defs/digest"}, "observed_at": {"$ref": "#/$defs/timestamp"}, "http_status": {"type": "integer", "minimum": 0, "maximum": 599}, "probe_count": {"type": "integer", "minimum": 1, "maximum": 1000000}, "successful_probe_count": {"$ref": "#/$defs/count"}}
    },
    "asset_result": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "owner_group", "public_url_sha256", "rendered_copy_sha256", "monitoring_config_sha256", "route_test_sha256", "owner_decision_sha256", "observed_at", "http_status", "probe_count", "successful_probe_count", "probe_age_seconds", "live"],
      "properties": {"id": {"$ref": "#/$defs/asset_id"}, "owner_group": {"$ref": "#/$defs/owner_group"}, "public_url_sha256": {"$ref": "#/$defs/digest"}, "rendered_copy_sha256": {"$ref": "#/$defs/digest"}, "monitoring_config_sha256": {"$ref": "#/$defs/digest"}, "route_test_sha256": {"$ref": "#/$defs/digest"}, "owner_decision_sha256": {"$ref": "#/$defs/digest"}, "observed_at": {"$ref": "#/$defs/timestamp"}, "http_status": {"type": "integer", "minimum": 0, "maximum": 599}, "probe_count": {"type": "integer", "minimum": 1, "maximum": 1000000}, "successful_probe_count": {"$ref": "#/$defs/count"}, "probe_age_seconds": {"type": "integer", "minimum": 0, "maximum": 100000000}, "live": {"type": "boolean"}}
    },
    "check": {"type": "object", "additionalProperties": false, "required": ["id", "outcome", "evidence_sha256"], "properties": {"id": {"$ref": "#/$defs/check_id"}, "outcome": {"enum": ["passed", "failed", "inconclusive"]}, "evidence_sha256": {"$ref": "#/$defs/digest"}}}
  }
}

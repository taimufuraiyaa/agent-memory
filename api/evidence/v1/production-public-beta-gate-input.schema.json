{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/production-public-beta-gate-input.schema.json",
  "title": "Agent Memory production public-beta shared-window gate input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "gate_review_id", "abuse_policy_version", "cost_policy_version", "review_policy_version", "inventory_id", "inventory_receipt_sha256", "plan_id", "plan_receipt_sha256", "change_id", "change_receipt_sha256", "release_id", "release_receipt_sha256", "billing_reconciliation_id", "billing_receipt_sha256", "beta_slo_observation_id", "beta_slo_receipt_sha256", "beta_operations_assessment_id", "beta_operations_receipt_sha256", "beta_integrity_review_id", "beta_integrity_receipt_sha256", "window_start", "window_end", "abuse_export_sha256", "cost_export_sha256", "target_decision_sha256", "domain_owner_review_sha256", "target_approved_at", "snapshot_at", "reviewed_at", "generated_at", "signup_attempt_count", "abuse_finding_count", "closed_abuse_finding_count", "open_nonblocking_abuse_finding_count", "open_launch_blocking_abuse_finding_count", "unclassified_abuse_finding_count", "active_tenant_count", "actual_window_cost_microusd", "maximum_window_cost_microusd", "maximum_cost_per_active_tenant_microusd", "ready", "checks"],
  "properties": {
    "schema": {"const": "agent-memory-production-public-beta-gate-input-v1"},
    "classification": {"const": "production_external"},
    "environment": {"const": "production"},
    "gate_review_id": {"$ref": "#/$defs/opaque"},
    "abuse_policy_version": {"$ref": "#/$defs/opaque"},
    "cost_policy_version": {"$ref": "#/$defs/opaque"},
    "review_policy_version": {"$ref": "#/$defs/opaque"},
    "inventory_id": {"$ref": "#/$defs/opaque"},
    "inventory_receipt_sha256": {"$ref": "#/$defs/digest"},
    "plan_id": {"$ref": "#/$defs/opaque"},
    "plan_receipt_sha256": {"$ref": "#/$defs/digest"},
    "change_id": {"$ref": "#/$defs/opaque"},
    "change_receipt_sha256": {"$ref": "#/$defs/digest"},
    "release_id": {"$ref": "#/$defs/opaque"},
    "release_receipt_sha256": {"$ref": "#/$defs/digest"},
    "billing_reconciliation_id": {"$ref": "#/$defs/opaque"},
    "billing_receipt_sha256": {"$ref": "#/$defs/digest"},
    "beta_slo_observation_id": {"$ref": "#/$defs/opaque"},
    "beta_slo_receipt_sha256": {"$ref": "#/$defs/digest"},
    "beta_operations_assessment_id": {"$ref": "#/$defs/opaque"},
    "beta_operations_receipt_sha256": {"$ref": "#/$defs/digest"},
    "beta_integrity_review_id": {"$ref": "#/$defs/opaque"},
    "beta_integrity_receipt_sha256": {"$ref": "#/$defs/digest"},
    "window_start": {"$ref": "#/$defs/timestamp"},
    "window_end": {"$ref": "#/$defs/timestamp"},
    "abuse_export_sha256": {"$ref": "#/$defs/digest"},
    "cost_export_sha256": {"$ref": "#/$defs/digest"},
    "target_decision_sha256": {"$ref": "#/$defs/digest"},
    "domain_owner_review_sha256": {"$ref": "#/$defs/digest"},
    "target_approved_at": {"$ref": "#/$defs/timestamp"},
    "snapshot_at": {"$ref": "#/$defs/timestamp"},
    "reviewed_at": {"$ref": "#/$defs/timestamp"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "signup_attempt_count": {"$ref": "#/$defs/positive_count"},
    "abuse_finding_count": {"$ref": "#/$defs/count"},
    "closed_abuse_finding_count": {"$ref": "#/$defs/count"},
    "open_nonblocking_abuse_finding_count": {"$ref": "#/$defs/count"},
    "open_launch_blocking_abuse_finding_count": {"$ref": "#/$defs/count"},
    "unclassified_abuse_finding_count": {"$ref": "#/$defs/count"},
    "active_tenant_count": {"$ref": "#/$defs/positive_count"},
    "actual_window_cost_microusd": {"$ref": "#/$defs/money"},
    "maximum_window_cost_microusd": {"$ref": "#/$defs/positive_money"},
    "maximum_cost_per_active_tenant_microusd": {"$ref": "#/$defs/positive_money"},
    "ready": {"type": "boolean"},
    "checks": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "count": {"type": "integer", "minimum": 0, "maximum": 100000000},
    "positive_count": {"type": "integer", "minimum": 1, "maximum": 100000000},
    "money": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
    "positive_money": {"type": "integer", "minimum": 1, "maximum": 1000000000000000},
    "check_id": {"enum": ["prerequisite_receipts_ready", "shared_window_complete", "billing_gate_passed", "abuse_export_complete", "abuse_findings_classified", "no_launch_blocking_abuse", "cost_export_complete", "cost_ceiling_passed", "domain_owner_review_complete"]},
    "check": {"type": "object", "additionalProperties": false, "required": ["id", "outcome", "evidence_sha256"], "properties": {"id": {"$ref": "#/$defs/check_id"}, "outcome": {"enum": ["passed", "failed", "inconclusive"]}, "evidence_sha256": {"$ref": "#/$defs/digest"}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/staging-object-custody-review.schema.json",
  "title": "Agent Memory staging object-custody review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "review_id", "inventory_id", "inventory_receipt_sha256", "change_id", "change_receipt_sha256", "release_id", "release_receipt_sha256", "ready", "generated_at", "review", "checks"],
  "properties": {
    "schema": {"const": "agent-memory-staging-object-custody-review-v1"},
    "classification": {"const": "staging_external"},
    "environment": {"const": "staging"},
    "review_id": {"$ref": "#/$defs/opaque_id"},
    "inventory_id": {"$ref": "#/$defs/opaque_id"},
    "inventory_receipt_sha256": {"$ref": "#/$defs/digest"},
    "change_id": {"$ref": "#/$defs/opaque_id"},
    "change_receipt_sha256": {"$ref": "#/$defs/digest"},
    "release_id": {"$ref": "#/$defs/opaque_id"},
    "release_receipt_sha256": {"$ref": "#/$defs/digest"},
    "ready": {"type": "boolean"},
    "generated_at": {"type": "string", "format": "date-time"},
    "review": {"$ref": "#/$defs/review_window"},
    "checks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "review_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "evidence_sha256"],
      "properties": {
        "id": {"enum": ["deployed_object_policy_export_verified", "api_object_capabilities_verified", "worker_object_capabilities_verified", "reconciler_object_capabilities_verified", "vault_immutability_verified", "quarantine_promotion_and_removal_verified", "audit_archive_immutability_verified", "source_content_absent_from_logs", "source_content_absent_from_traces", "telemetry_access_restricted"]},
        "outcome": {"enum": ["passed", "failed"]},
        "evidence_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}

    "blocker_category_count":{"const":4},"total_blocker_count":{"$ref":"#/$defs/count"},"resolved_blocker_count":{"$ref":"#/$defs/count"},"deferred_blocker_count":{"$ref":"#/$defs/count"},"open_blocker_count":{"$ref":"#/$defs/count"},"unowned_blocker_count":{"$ref":"#/$defs/count"},"staffing_domain_count":{"const":3},"covered_staffing_domain_count":{"$ref":"#/$defs/count"},"check_count":{"const":10},"passed_count":{"$ref":"#/$defs/count"},"failed_count":{"$ref":"#/$defs/count"},"inconclusive_count":{"$ref":"#/$defs/count"},
    "evidence_digests":{"type":"object","additionalProperties":false,"required":["decision_register","topology_review","facility_review","recovery_exit_review","integration_boundary","jurisdiction_decision","blocker_register","cost_forecast","infrastructure_cost_cap_decision","beta_cap_decision","staffing_plan","cp0a_review","cp0b_review"],"properties":{"decision_register":{"$ref":"#/$defs/digest"},"topology_review":{"$ref":"#/$defs/digest"},"facility_review":{"$ref":"#/$defs/digest"},"recovery_exit_review":{"$ref":"#/$defs/digest"},"integration_boundary":{"$ref":"#/$defs/digest"},"jurisdiction_decision":{"$ref":"#/$defs/digest"},"blocker_register":{"$ref":"#/$defs/digest"},"cost_forecast":{"$ref":"#/$defs/digest"},"infrastructure_cost_cap_decision":{"$ref":"#/$defs/digest"},"beta_cap_decision":{"$ref":"#/$defs/digest"},"staffing_plan":{"$ref":"#/$defs/digest"},"cp0a_review":{"$ref":"#/$defs/digest"},"cp0b_review":{"$ref":"#/$defs/digest"}}},
    "blockers":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/blocker"}},"staffing":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/staffing"}},"checks":{"type":"array","minItems":10,"maxItems":10,"items":{"$ref":"#/$defs/check"}}

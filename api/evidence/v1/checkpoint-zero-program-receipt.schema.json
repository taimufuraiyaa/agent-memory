  "$defs":{
    "opaque":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"count":{"type":"integer","minimum":0,"maximum":1000000000},"money":{"type":"integer","minimum":0,"maximum":9223372036854775807},"outcome":{"enum":["passed","failed","inconclusive"]},
    "blocker":{"type":"object","additionalProperties":false,"required":["id","total_count","resolved_count","deferred_count","open_count","unowned_count","outcome","evidence_sha256"],"properties":{"id":{"enum":["infrastructure_ownership","topology","external_integration","jurisdiction"]},"total_count":{"$ref":"#/$defs/count"},"resolved_count":{"$ref":"#/$defs/count"},"deferred_count":{"$ref":"#/$defs/count"},"open_count":{"$ref":"#/$defs/count"},"unowned_count":{"$ref":"#/$defs/count"},"outcome":{"$ref":"#/$defs/outcome"},"evidence_sha256":{"$ref":"#/$defs/digest"}}},
    "staffing":{"type":"object","additionalProperties":false,"required":["id","required_coverage_minutes","primary_covered_minutes","backup_covered_minutes","primary_slot_count","backup_slot_count","outcome","evidence_sha256"],"properties":{"id":{"enum":["on_call","support","notice"]},"required_coverage_minutes":{"$ref":"#/$defs/count"},"primary_covered_minutes":{"$ref":"#/$defs/count"},"backup_covered_minutes":{"$ref":"#/$defs/count"},"primary_slot_count":{"$ref":"#/$defs/count"},"backup_slot_count":{"$ref":"#/$defs/count"},"outcome":{"$ref":"#/$defs/outcome"},"evidence_sha256":{"$ref":"#/$defs/digest"}}},

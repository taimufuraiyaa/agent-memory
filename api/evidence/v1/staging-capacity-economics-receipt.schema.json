{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/staging-capacity-economics-receipt.schema.json",
  "title": "Agent Memory private-beta capacity and economics receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "assessment_id", "capacity_model_version", "entitlement_version", "economics_version", "beta_cap_version", "inventory_id", "inventory_receipt_sha256", "plan_id", "plan_receipt_sha256", "change_id", "change_receipt_sha256", "release_id", "release_receipt_sha256", "retrieval_load_run_id", "retrieval_load_receipt_sha256", "installed_launch_policy_sha256", "entitlement_snapshot_sha256", "capacity_report_sha256", "economics_report_sha256", "decision_sha256", "decision_approved_at", "assessment_started_at", "assessment_completed_at", "generated_at", "beta_account_cap", "planned_peak_concurrent_tenants", "supported_concurrent_tenants", "planned_peak_retrieval_requests_per_minute", "sustained_retrieval_requests_per_minute", "fixed_monthly_cost_microusd", "variable_monthly_cost_per_tenant_microusd", "estimated_worst_case_monthly_cost_microusd", "approved_monthly_cost_ceiling_microusd", "ready", "checks", "input_sha256", "collected_at", "check_count", "passed_count", "failed_count", "inconclusive_count", "metric_breach_count"],
  "properties": {
    "schema": {"const": "agent-memory-staging-capacity-economics-receipt-v1"}, "classification": {"const": "staging_external"}, "environment": {"const": "staging"},
    "assessment_id": {"$ref": "#/$defs/opaque_id"}, "capacity_model_version": {"$ref": "#/$defs/opaque_id"}, "entitlement_version": {"$ref": "#/$defs/opaque_id"}, "economics_version": {"$ref": "#/$defs/opaque_id"}, "beta_cap_version": {"$ref": "#/$defs/opaque_id"},
    "inventory_id": {"$ref": "#/$defs/opaque_id"}, "inventory_receipt_sha256": {"$ref": "#/$defs/digest"}, "plan_id": {"$ref": "#/$defs/opaque_id"}, "plan_receipt_sha256": {"$ref": "#/$defs/digest"}, "change_id": {"$ref": "#/$defs/opaque_id"}, "change_receipt_sha256": {"$ref": "#/$defs/digest"}, "release_id": {"$ref": "#/$defs/opaque_id"}, "release_receipt_sha256": {"$ref": "#/$defs/digest"},
    "retrieval_load_run_id": {"$ref": "#/$defs/opaque_id"}, "retrieval_load_receipt_sha256": {"$ref": "#/$defs/digest"}, "installed_launch_policy_sha256": {"$ref": "#/$defs/digest"}, "entitlement_snapshot_sha256": {"$ref": "#/$defs/digest"}, "capacity_report_sha256": {"$ref": "#/$defs/digest"}, "economics_report_sha256": {"$ref": "#/$defs/digest"}, "decision_sha256": {"$ref": "#/$defs/digest"}, "input_sha256": {"$ref": "#/$defs/digest"},
    "decision_approved_at": {"type": "string", "format": "date-time"}, "assessment_started_at": {"type": "string", "format": "date-time"}, "assessment_completed_at": {"type": "string", "format": "date-time"}, "generated_at": {"type": "string", "format": "date-time"}, "collected_at": {"type": "string", "format": "date-time"},
    "beta_account_cap": {"$ref": "#/$defs/positive_count"}, "planned_peak_concurrent_tenants": {"$ref": "#/$defs/positive_count"}, "supported_concurrent_tenants": {"$ref": "#/$defs/positive_count"}, "planned_peak_retrieval_requests_per_minute": {"$ref": "#/$defs/positive_rate"}, "sustained_retrieval_requests_per_minute": {"$ref": "#/$defs/positive_rate"},
    "fixed_monthly_cost_microusd": {"$ref": "#/$defs/cost"}, "variable_monthly_cost_per_tenant_microusd": {"$ref": "#/$defs/positive_cost"}, "estimated_worst_case_monthly_cost_microusd": {"$ref": "#/$defs/positive_cost"}, "approved_monthly_cost_ceiling_microusd": {"$ref": "#/$defs/positive_cost"},
    "ready": {"type": "boolean"}, "checks": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/check"}}, "check_count": {"const": 8}, "passed_count": {"type": "integer", "minimum": 0, "maximum": 8}, "failed_count": {"type": "integer", "minimum": 0, "maximum": 8}, "inconclusive_count": {"type": "integer", "minimum": 0, "maximum": 8}, "metric_breach_count": {"type": "integer", "minimum": 0, "maximum": 3}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "opaque_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "positive_count": {"type": "integer", "minimum": 1, "maximum": 100000000}, "positive_rate": {"type": "integer", "minimum": 1, "maximum": 1000000000000}, "cost": {"type": "integer", "minimum": 0, "maximum": 1000000000000000}, "positive_cost": {"type": "integer", "minimum": 1, "maximum": 1000000000000000},
    "check": {"type": "object", "additionalProperties": false, "required": ["id", "outcome", "evidence_sha256"], "properties": {"id": {"enum": ["beta_cap_approved", "deployed_retrieval_load_ready", "installed_capacity_measured", "tenant_concurrency_headroom_met", "retrieval_throughput_headroom_met", "quota_envelope_reconciled", "worst_case_economics_reconciled", "monthly_cost_ceiling_met"]}, "outcome": {"enum": ["passed", "failed", "inconclusive"]}, "evidence_sha256": {"$ref": "#/$defs/digest"}}}
  }
}

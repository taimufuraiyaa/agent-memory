{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/staging-migration-cohort-input.schema.json",
  "title": "Agent Memory representative staging migration-cohort input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "cohort_id", "dataset_version", "consent_version", "importer_version", "inventory_id", "inventory_receipt_sha256", "plan_id", "plan_receipt_sha256", "change_id", "change_receipt_sha256", "release_id", "release_receipt_sha256", "cohort_decision_sha256", "cohort_report_sha256", "consent_approved_at", "started_at", "completed_at", "generated_at", "account_count", "library_count", "source_count", "memory_count", "note_count", "expected_item_count", "imported_item_count", "merged_item_count", "skipped_item_count", "failed_item_count", "unexplained_loss_count", "duplicate_publication_count", "formats", "size_buckets", "ready", "checks"],
  "properties": {
    "schema": {"const": "agent-memory-staging-migration-cohort-input-v1"},
    "classification": {"const": "staging_external"},
    "environment": {"const": "staging"},
    "cohort_id": {"$ref": "#/$defs/opaque_id"},
    "dataset_version": {"$ref": "#/$defs/opaque_id"},
    "consent_version": {"$ref": "#/$defs/opaque_id"},
    "importer_version": {"$ref": "#/$defs/opaque_id"},
    "inventory_id": {"$ref": "#/$defs/opaque_id"},
    "inventory_receipt_sha256": {"$ref": "#/$defs/digest"},
    "plan_id": {"$ref": "#/$defs/opaque_id"},
    "plan_receipt_sha256": {"$ref": "#/$defs/digest"},
    "change_id": {"$ref": "#/$defs/opaque_id"},
    "change_receipt_sha256": {"$ref": "#/$defs/digest"},
    "release_id": {"$ref": "#/$defs/opaque_id"},
    "release_receipt_sha256": {"$ref": "#/$defs/digest"},
    "cohort_decision_sha256": {"$ref": "#/$defs/digest"},
    "cohort_report_sha256": {"$ref": "#/$defs/digest"},
    "consent_approved_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "account_count": {"$ref": "#/$defs/positive_count"},
    "library_count": {"$ref": "#/$defs/positive_count"},
    "source_count": {"$ref": "#/$defs/positive_count"},
    "memory_count": {"$ref": "#/$defs/count"},
    "note_count": {"$ref": "#/$defs/count"},
    "expected_item_count": {"$ref": "#/$defs/positive_count"},
    "imported_item_count": {"$ref": "#/$defs/count"},
    "merged_item_count": {"$ref": "#/$defs/count"},
    "skipped_item_count": {"$ref": "#/$defs/count"},
    "failed_item_count": {"$ref": "#/$defs/count"},
    "unexplained_loss_count": {"$ref": "#/$defs/count"},
    "duplicate_publication_count": {"$ref": "#/$defs/count"},
    "formats": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/format_coverage"}},
    "size_buckets": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/size_coverage"}},
    "ready": {"type": "boolean"},
    "checks": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 10000000},
    "positive_count": {"type": "integer", "minimum": 1, "maximum": 10000000},
    "format_coverage": {"type": "object", "additionalProperties": false, "required": ["format", "source_count"], "properties": {"format": {"enum": ["pdf", "epub", "markdown", "text"]}, "source_count": {"$ref": "#/$defs/positive_count"}}},
    "size_coverage": {"type": "object", "additionalProperties": false, "required": ["bucket", "source_count"], "properties": {"bucket": {"enum": ["small", "medium", "large"]}, "source_count": {"$ref": "#/$defs/positive_count"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["id", "outcome", "evidence_sha256"], "properties": {"id": {"enum": ["cohort_consent_authorized", "cohort_representative", "bundle_integrity_verified", "import_completed", "reconciliation_complete", "no_unexplained_loss", "no_duplicate_publication", "failures_reviewed", "product_qa_review_complete"]}, "outcome": {"enum": ["passed", "failed", "inconclusive"]}, "evidence_sha256": {"$ref": "#/$defs/digest"}}}
  }
}

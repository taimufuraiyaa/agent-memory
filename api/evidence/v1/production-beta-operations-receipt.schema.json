{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/production-beta-operations-receipt.schema.json",
  "title": "Agent Memory production beta trust-operations receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "assessment_id", "aggregate_policy_version", "sample_policy_version", "target_version", "support_export_version", "inventory_id", "inventory_receipt_sha256", "plan_id", "plan_receipt_sha256", "change_id", "change_receipt_sha256", "release_id", "release_receipt_sha256", "beta_slo_observation_id", "beta_slo_receipt_sha256", "window_start", "window_end", "deletion_receipt_export_sha256", "notice_case_export_sha256", "anomaly_case_export_sha256", "support_case_export_sha256", "sample_manifest_sha256", "target_decision_sha256", "privacy_security_support_review_sha256", "target_approved_at", "aggregated_at", "reviewed_at", "generated_at", "ready", "domains", "checks", "input_sha256", "collected_at", "due_case_count", "within_target_count", "late_case_count", "overdue_open_count", "sample_coverage_complete", "sample_shortfall_count", "target_breach_count", "domain_results", "check_count", "passed_count", "failed_count", "inconclusive_count"],
  "properties": {
    "schema": {"const": "agent-memory-production-beta-operations-receipt-v1"},
    "classification": {"const": "production_external"},
    "environment": {"const": "production"},
    "assessment_id": {"$ref": "#/$defs/opaque"},
    "aggregate_policy_version": {"$ref": "#/$defs/opaque"},
    "sample_policy_version": {"$ref": "#/$defs/opaque"},
    "target_version": {"$ref": "#/$defs/opaque"},
    "support_export_version": {"$ref": "#/$defs/opaque"},
    "inventory_id": {"$ref": "#/$defs/opaque"},
    "inventory_receipt_sha256": {"$ref": "#/$defs/digest"},
    "plan_id": {"$ref": "#/$defs/opaque"},
    "plan_receipt_sha256": {"$ref": "#/$defs/digest"},
    "change_id": {"$ref": "#/$defs/opaque"},
    "change_receipt_sha256": {"$ref": "#/$defs/digest"},
    "release_id": {"$ref": "#/$defs/opaque"},
    "release_receipt_sha256": {"$ref": "#/$defs/digest"},
    "beta_slo_observation_id": {"$ref": "#/$defs/opaque"},
    "beta_slo_receipt_sha256": {"$ref": "#/$defs/digest"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "deletion_receipt_export_sha256": {"$ref": "#/$defs/digest"},
    "notice_case_export_sha256": {"$ref": "#/$defs/digest"},
    "anomaly_case_export_sha256": {"$ref": "#/$defs/digest"},
    "support_case_export_sha256": {"$ref": "#/$defs/digest"},
    "sample_manifest_sha256": {"$ref": "#/$defs/digest"},
    "target_decision_sha256": {"$ref": "#/$defs/digest"},
    "privacy_security_support_review_sha256": {"$ref": "#/$defs/digest"},
    "target_approved_at": {"type": "string", "format": "date-time"},
    "aggregated_at": {"type": "string", "format": "date-time"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "ready": {"type": "boolean"},
    "domains": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/domain"}},
    "checks": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/check"}},
    "input_sha256": {"$ref": "#/$defs/digest"},
    "collected_at": {"type": "string", "format": "date-time"},
    "due_case_count": {"$ref": "#/$defs/count"},
    "within_target_count": {"$ref": "#/$defs/count"},
    "late_case_count": {"$ref": "#/$defs/count"},
    "overdue_open_count": {"$ref": "#/$defs/count"},
    "sample_coverage_complete": {"type": "boolean"},
    "sample_shortfall_count": {"type": "integer", "minimum": 0, "maximum": 4},
    "target_breach_count": {"type": "integer", "minimum": 0, "maximum": 4},
    "domain_results": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/domain_result"}},
    "check_count": {"const": 9},
    "passed_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "failed_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "inconclusive_count": {"type": "integer", "minimum": 0, "maximum": 9}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 100000000},
    "domain_id": {"enum": ["deletion", "rights_notice", "anomaly_alert", "support_case"]},
    "check_id": {"enum": ["shared_window_exports_complete", "target_sample_policy_approved", "aggregate_reconciliation_complete", "case_sample_coverage_complete", "deletion_operations_within_target", "notice_operations_within_target", "anomaly_operations_within_target", "support_operations_within_target", "privacy_security_support_review_complete"]},
    "domain": {"type": "object", "additionalProperties": false, "required": ["id", "due_case_count", "within_target_count", "late_case_count", "overdue_open_count", "required_sample_count", "sampled_case_count", "matched_sample_count", "maximum_target_seconds", "maximum_observed_duration_seconds", "evidence_sha256"], "properties": {"id": {"$ref": "#/$defs/domain_id"}, "due_case_count": {"$ref": "#/$defs/count"}, "within_target_count": {"$ref": "#/$defs/count"}, "late_case_count": {"$ref": "#/$defs/count"}, "overdue_open_count": {"$ref": "#/$defs/count"}, "required_sample_count": {"$ref": "#/$defs/count"}, "sampled_case_count": {"$ref": "#/$defs/count"}, "matched_sample_count": {"$ref": "#/$defs/count"}, "maximum_target_seconds": {"type": "integer", "minimum": 1, "maximum": 2678400}, "maximum_observed_duration_seconds": {"type": "integer", "minimum": 0, "maximum": 31536000}, "evidence_sha256": {"$ref": "#/$defs/digest"}}},
    "domain_result": {"type": "object", "additionalProperties": false, "required": ["id", "due_case_count", "within_target_count", "late_case_count", "overdue_open_count", "required_sample_count", "sampled_case_count", "matched_sample_count", "maximum_target_seconds", "maximum_observed_duration_seconds", "evidence_sha256", "reconciled", "sample_coverage_complete", "target_met"], "properties": {"id": {"$ref": "#/$defs/domain_id"}, "due_case_count": {"$ref": "#/$defs/count"}, "within_target_count": {"$ref": "#/$defs/count"}, "late_case_count": {"$ref": "#/$defs/count"}, "overdue_open_count": {"$ref": "#/$defs/count"}, "required_sample_count": {"$ref": "#/$defs/count"}, "sampled_case_count": {"$ref": "#/$defs/count"}, "matched_sample_count": {"$ref": "#/$defs/count"}, "maximum_target_seconds": {"type": "integer", "minimum": 1, "maximum": 2678400}, "maximum_observed_duration_seconds": {"type": "integer", "minimum": 0, "maximum": 31536000}, "evidence_sha256": {"$ref": "#/$defs/digest"}, "reconciled": {"type": "boolean"}, "sample_coverage_complete": {"type": "boolean"}, "target_met": {"type": "boolean"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["id", "outcome", "evidence_sha256"], "properties": {"id": {"$ref": "#/$defs/check_id"}, "outcome": {"enum": ["passed", "failed", "inconclusive"]}, "evidence_sha256": {"$ref": "#/$defs/digest"}}}
  }
}

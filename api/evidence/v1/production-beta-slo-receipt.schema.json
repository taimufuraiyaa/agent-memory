{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory.local/schemas/evidence/v1/production-beta-slo-receipt.schema.json",
  "title": "Agent Memory production beta SLO observation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classification", "environment", "observation_id", "metric_source_version", "query_manifest_version", "slo_definition_version", "window_decision_version", "inventory_id", "inventory_receipt_sha256", "plan_id", "plan_receipt_sha256", "change_id", "change_receipt_sha256", "release_id", "release_receipt_sha256", "metric_export_sha256", "query_manifest_sha256", "window_decision_sha256", "slo_definition_decision_sha256", "product_operations_review_sha256", "window_approved_at", "window_start", "window_end", "evaluated_at", "generated_at", "minimum_window_seconds", "ready", "metrics", "checks", "input_sha256", "collected_at", "observation_duration_seconds", "coverage_complete", "coverage_shortfall_count", "metric_breach_count", "metric_results", "check_count", "passed_count", "failed_count", "inconclusive_count"],
  "properties": {
    "schema": {"const": "agent-memory-production-beta-slo-receipt-v1"},
    "classification": {"const": "production_external"},
    "environment": {"const": "production"},
    "observation_id": {"$ref": "#/$defs/opaque"},
    "metric_source_version": {"$ref": "#/$defs/opaque"},
    "query_manifest_version": {"$ref": "#/$defs/opaque"},
    "slo_definition_version": {"$ref": "#/$defs/opaque"},
    "window_decision_version": {"$ref": "#/$defs/opaque"},
    "inventory_id": {"$ref": "#/$defs/opaque"},
    "inventory_receipt_sha256": {"$ref": "#/$defs/digest"},
    "plan_id": {"$ref": "#/$defs/opaque"},
    "plan_receipt_sha256": {"$ref": "#/$defs/digest"},
    "change_id": {"$ref": "#/$defs/opaque"},
    "change_receipt_sha256": {"$ref": "#/$defs/digest"},
    "release_id": {"$ref": "#/$defs/opaque"},
    "release_receipt_sha256": {"$ref": "#/$defs/digest"},
    "metric_export_sha256": {"$ref": "#/$defs/digest"},
    "query_manifest_sha256": {"$ref": "#/$defs/digest"},
    "window_decision_sha256": {"$ref": "#/$defs/digest"},
    "slo_definition_decision_sha256": {"$ref": "#/$defs/digest"},
    "product_operations_review_sha256": {"$ref": "#/$defs/digest"},
    "window_approved_at": {"type": "string", "format": "date-time"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "minimum_window_seconds": {"type": "integer", "minimum": 86400, "maximum": 2678400},
    "ready": {"type": "boolean"},
    "metrics": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/metric"}},
    "checks": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/check"}},
    "input_sha256": {"$ref": "#/$defs/digest"},
    "collected_at": {"type": "string", "format": "date-time"},
    "observation_duration_seconds": {"type": "integer", "minimum": 86400, "maximum": 2678400},
    "coverage_complete": {"type": "boolean"},
    "coverage_shortfall_count": {"type": "integer", "minimum": 0, "maximum": 6},
    "metric_breach_count": {"type": "integer", "minimum": 0, "maximum": 6},
    "metric_results": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/metric_result"}},
    "check_count": {"const": 6},
    "passed_count": {"type": "integer", "minimum": 0, "maximum": 6},
    "failed_count": {"type": "integer", "minimum": 0, "maximum": 6},
    "inconclusive_count": {"type": "integer", "minimum": 0, "maximum": 6}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opaque": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "metric_id": {"enum": ["api_availability_ppm", "search_p95_microseconds", "memory_write_p95_microseconds", "status_metadata_p95_microseconds", "upload_acceptance_p95_microseconds", "native_text_indexing_within_60s_ppm"]},
    "check_id": {"enum": ["observation_window_approved", "immutable_metric_export_complete", "query_manifest_reviewed", "metric_sample_coverage_complete", "provisional_slo_targets_met", "product_operations_review_complete"]},
    "metric": {"type": "object", "additionalProperties": false, "required": ["id", "observed_value", "expected_sample_count", "observed_sample_count", "evidence_sha256"], "properties": {"id": {"$ref": "#/$defs/metric_id"}, "observed_value": {"type": "integer", "minimum": 0, "maximum": 86400000000}, "expected_sample_count": {"type": "integer", "minimum": 1, "maximum": 1000000000}, "observed_sample_count": {"type": "integer", "minimum": 1, "maximum": 1000000000}, "evidence_sha256": {"$ref": "#/$defs/digest"}}},
    "metric_result": {"type": "object", "additionalProperties": false, "required": ["id", "observed_value", "expected_sample_count", "observed_sample_count", "evidence_sha256", "comparator", "target_value", "coverage_complete", "passed"], "properties": {"id": {"$ref": "#/$defs/metric_id"}, "observed_value": {"type": "integer", "minimum": 0, "maximum": 86400000000}, "expected_sample_count": {"type": "integer", "minimum": 1, "maximum": 1000000000}, "observed_sample_count": {"type": "integer", "minimum": 1, "maximum": 1000000000}, "evidence_sha256": {"$ref": "#/$defs/digest"}, "comparator": {"enum": ["gte", "lte"]}, "target_value": {"type": "integer", "minimum": 1, "maximum": 2000000}, "coverage_complete": {"type": "boolean"}, "passed": {"type": "boolean"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["id", "outcome", "evidence_sha256"], "properties": {"id": {"$ref": "#/$defs/check_id"}, "outcome": {"enum": ["passed", "failed", "inconclusive"]}, "evidence_sha256": {"$ref": "#/$defs/digest"}}}
  }
}
